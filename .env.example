# Copy values from your database provider into a local, untracked .env file.
# Do not commit real connection strings.
MONGODB_USERS_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
MONGODB_BLOG_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
MONGODB_ARTICLES_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
