 <br>
  <br>

  <!--content-->


  <div class="container mt-5 bg-custom-two text-light">
    <div class="row">
        <div class="col-lg-8">
            <article>
                <header class="mb-4">
                    <div class="d-flex fit-con flex-row justify-content-between">                    
                      <h2 class="fw-bold my-color mb-1 m-2">{{article.topic}}</h2> <h5 class="mb-1 m-2 my-badge p-1 fs-5"><i>{{article.badge}}</i></h5>
                    </div>
                    <div class="text-muted fst-italic mb-2">Posted on: {{article.date}}</div>
                    <a class="badge bg-secondary text-decoration-none link-light" href="#!">{{article.tag}}</a>
                </header>
               <figure class="mb-4"><img class="img-fluid border border-primary" src="../resources/image3.jpg" alt="">
                </figure>
                {{!--  --}}
                {{{article.desc}}}
                {{!--  --}}
            </article>
            
        </div>
        <div class="col-lg-4">
            <div class="card bg-custom-two mb-4 m-2">
                <div class="card-header text-dark bg-bar">Search</div>
                <div class="card-body">
                    <div class="input-group">
                        <input class="form-control" type="text" placeholder="Enter search term..." aria-label="Enter search term..." aria-describedby="button-search" />
                        <button class="btn btn-primary" id="button-search" type="button">Go!</button>
                    </div>
                </div>
            </div>
            <div class="card bg-custom-two mb-4 m-2">
                <div class="card-header bg-bar text-dark">Categories</div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-sm-6">
                            <ul class="list-unstyled mb-0">
                                <li><a id = "a-sides" href="#!">Web Design</a></li>
                                <li><a id = "a-sides" href="#!">HTML</a></li>
                            </ul>
                        </div>
                        <div class="col-sm-6">
                            <ul class="list-unstyled mb-0">
                                <li><a id = "a-sides" href="#!">JavaScript</a></li>
                                <li><a id = "a-sides" href="#!">CSS</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card bg-custom-two mb-4">
                <div class="card-header bg-bar text-dark">24/7 Expert Support</div>
                <div class="card-body">Our in-house, expert team is always on hand to help answer your questions, get you started, and grow your presence online.
                You can contact us any time!</div>
            </div>
        </div>
    </div>
</div>

<!--  -->

<br>

<section class="mb-5 text-light container p-2">
  <div class="card bg-custom-two">
      <div class="card-body">
          <div class="bg-custom p-2">
            <form class="mb-4"><textarea class="form-control" rows="3" placeholder="Join the discussion and leave a comment!"></textarea></form>
            <button type="submit" class="btn btn-primary" id="btnLogin">Submit</button>
          </div>
          <h2 class="text-dark bg-bar m-4 p-2 fs-4">Comments</h2>



          {{!--  --}}
          {{#each comments}}
          <div class="d-flex mb-4 bg-custom-two p-2 m-1 fit-con">
              <div class="flex-shrink-0"> <img class="rounded-circle" src="../resources/icon1.png" alt=""></div>
              <div class="ms-3">
                  <div class="fw-bold my-color m-1">{{this.name}}</div>
                  {{this.comment}}
                  {{#if this.replies}}
                  {{#each this.replies}}
                    <div class="d-flex mt-4 bg-custom p-2 m-1 align-items-center">
                    <div class="flex-shrink-0"> <img class="rounded-circle" src="../resources/icon2.png" alt=""></div>
                    <div class="ms-3 bg-custom-low p-2 m-1">
                          <div class="fw-bold my-color m-1">{{this.name}}</div>
                          {{this.comment}}</div>
                  </div>
                  {{/each}}
                  {{/if}}

              </div>
          </div>
          {{/each}}
          {{!--  --}}
      </div>
  </div>
</section>